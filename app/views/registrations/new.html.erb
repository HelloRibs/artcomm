<h1>Sign up</h1>

<%= form_with model: @user, url: signup_path, method: :post do |form| %>
  <% if @user.errors.any? %>
    <ul role="alert">
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= form.label :email %>
    <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email" %>
  </div>

  <div>
    <%= form.label :username %>
    <%= form.text_field :username, required: true, autocomplete: "username" %>
    <small>Your public address: <%= root_url %>your-username</small>
  </div>

  <div>
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "new-password" %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Confirm password" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
  </div>

  <%= form.submit "Sign up" %>
<% end %>

<p>Already have an account? <%= link_to "Sign in", login_path %></p>
