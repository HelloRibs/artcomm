<h1>Sign in</h1>

<%= form_with url: login_path, method: :post do |form| %>
  <div>
    <%= form.label :email %>
    <%= form.email_field :email, value: @email, required: true, autofocus: true, autocomplete: "email" %>
  </div>

  <div>
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "current-password" %>
  </div>

  <%= form.submit "Sign in" %>
<% end %>

<p>No account yet? <%= link_to "Sign up", signup_path %></p>
